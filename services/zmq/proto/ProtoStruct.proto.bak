}

//�״���ƹ�����Ϣ�ṹ
message PR_PUBLIC_CTRL {
optional PR_MSG_HEADER MsgHeader = 1;
optional PR_CONTROL_INFO_TYPE ControlInfoType = 2;	//��Ϣ����
optional uint32 SrcID = 3;		//��ϢԴ���
repeated uint32 DestID = 4;		//��Ϣ�ޱ��
optional uint32 TaskEncode = 5;  //  ��������
}

//��������������Ϣͷ
message PR_PUBLIC_CTRL_SLV {
