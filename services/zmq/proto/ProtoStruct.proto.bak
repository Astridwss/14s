}

//װ��λ��
message PR_EQUIPMENT_POSITION {
optional uint32 EquipID = 1;										//װ��վ��
optional uint32 EquipType = 2;									//װ�����ͣ�1-�״2-���ǣ�0-����
optional double Time = 3;											//ʱ�䣬�����ʼʱ�����������λ��s
optional PR_THREE_DIMENSION GeoPos = 4;			//λ�ã����ȡ�γ�ȡ��߶ȣ���λ��deg��deg��m
}

//Ŀ��λ��
message PR_TARGET_POSITION {
optional uint32 TargetID = 1;									//Ŀ����
optional double Time = 2;											//ʱ�䣬�����ʼʱ�����������λ��s
optional PR_THREE_DIMENSION GeoPos = 3;			//λ�ã����ȡ�γ�ȡ��߶ȣ���λ��deg��deg��m
}

//װ����Ŀ���̽���ϵ
message PR_EQUIPMENT_TARGET_DETECTION {
optional uint32 EquipID = 1;										//װ��վ��
optional uint32 TargetID = 2;									//Ŀ����
}

//强化学习训练中态势信息推送前台 12290
message PR_I_RL_TRAINING_SITUATION_TO_FRONT {
optional PR_PUBLIC_CTRL PubCtrl = 1;													//控制类型消息头
optional double CurrentTime = 2;															//当前时间，相对起始时间的秒数，单位S
repeated PR_EQUIPMENT_POSITION EquipPos = 3;								//装备位置
repeated PR_TARGET_POSITION TargetPos = 4;										//目标位置
repeated PR_EQUIPMENT_TARGET_DETECTION Detection = 5;				//装备与目标的探测关系
optional uint32 DataType = 6;																	//1-第一包， 2-最后一包， 0-中间数据
}
